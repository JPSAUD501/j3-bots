index 1e1123a7e7f4df662d656d2128cb9f70349a467f..a85e547fd9c810e4d04792ace6c09fb753ba3a6f 100644
--- a/dist/NodeChildProcessSpawner.js
+++ b/dist/NodeChildProcessSpawner.js
@@ -87,7 +87,10 @@ const taskkill = (childProcess, onExit = () => {}) => {
     onExit(null);
     return;
   }
-  NodeChildProcess.execFile("taskkill", ["/pid", String(childProcess.pid), "/T", "/F"], {
+  // By its full path in System32: a `taskkill` earlier on the search path, or
+  // in the working directory, would be run instead.
+  const program = `${globalThis.process.env["SystemRoot"] ?? "C:\\Windows"}\\System32\\taskkill.exe`;
+  NodeChildProcess.execFile(program, ["/pid", String(childProcess.pid), "/T", "/F"], {
     windowsHide: true
   }, onExit);
 };
