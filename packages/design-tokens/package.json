{
  "name": "@j3-bots/design-tokens",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./names": {
      "types": "./src/names.ts",
      "import": "./src/names.ts"
    },
    "./raster": {
      "types": "./src/raster/index.ts",
      "import": "./src/raster/index.ts"
    },
    "./web.css": "./generated/web.css",
    "./uniwind.css": "./generated/uniwind.css",
    "./fonts.json": "./generated/fonts.json",
    "./icons/*": "./generated/icons/*",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
