{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exports of a workspace package's entry points are its public API, so the
  // contract packages may export types before anything consumes them. Every
  // other export, type or not, must be used.
  // T3 Code's contracts, vendored as is: typechecked here, not ours to prune.
  "ignoreWorkspaces": ["packages/engine-t3/vendor/t3-contracts"],
  // A system tool a test runs: Node cannot make a FIFO itself.
  "ignoreBinaries": ["mkfifo"],
  "workspaces": {
    "apps/desktop": {
      // The main process, and the preload script Electron loads by the path
      // the window names: built into dist, which knip does not map back. The
      // hook electron-builder.yml names, which electron-builder loads.
      "entry": ["src/main.ts", "src/preload.ts", "scripts/afterPack.ts"],
      // The input hook's prebuilt binary, which the build copies out of the
      // package by path (vite.config.ts) and the app loads itself: nothing
      // imports the package.
      "ignoreDependencies": ["uiohook-napi"],
    },
    "apps/mobile": {
      // The config plugin prebuild loads by the path app.config.ts names.
      "entry": ["plugins/*.js"],
    },
    "apps/server": {
      // The `j3` bridge: the engine starts it as a process, by a path
      // `src/installation.ts` names, and the production build bundles it.
      "entry": ["src/bridge/main.ts"],
    },
    "packages/prompts": {
      // The behavior evals (`eval`), run on demand: entry points no import reaches.
      "entry": ["evals/*.eval.ts", "evals/vite.config.ts"],
    },
    "packages/engine-t3": {
      // The real-engine conformance run (`test:conformance`) and the scripted
      // agent the engine starts as a process: entry points no import reaches.
      "entry": [
        "conformance/*.conformance.ts",
        "conformance/vite.config.ts",
        "scripted-agent/agent.ts",
      ],
    },
  },
}
