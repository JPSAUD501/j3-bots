<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    The app installs its own update, a release APK it has checked against the
    release's signed SHA256SUMS (src/update). Android still asks the operator
    to allow installs from J3 Bots once, and to confirm each install.
  -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
