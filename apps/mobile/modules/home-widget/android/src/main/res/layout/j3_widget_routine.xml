<!-- A routine: its name, when it last ran, and, when there is room, the start of what it said. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/j3_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="12dp">
  <TextView
    android:id="@+id/j3_widget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:textColor="@color/j3_widget_foreground"
    android:textSize="14sp" />
  <TextView
    android:id="@+id/j3_widget_when"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/j3_widget_muted"
    android:textSize="12sp" />
  <TextView
    android:id="@+id/j3_widget_result"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:textColor="@color/j3_widget_foreground"
    android:textSize="13sp" />
</LinearLayout>
