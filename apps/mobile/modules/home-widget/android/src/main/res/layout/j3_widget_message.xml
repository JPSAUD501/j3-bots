<!-- What a widget says when it has nothing to show, and what a tap does about it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/j3_widget_background"
  android:clipToOutline="true"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="12dp">
  <TextView
    android:id="@+id/j3_widget_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="3"
    android:text="@string/j3_widget_label"
    android:textColor="@color/j3_widget_foreground"
    android:textSize="13sp" />
  <TextView
    android:id="@+id/j3_widget_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:gravity="center"
    android:maxLines="1"
    android:textColor="@color/j3_widget_muted"
    android:textSize="12sp" />
</LinearLayout>
