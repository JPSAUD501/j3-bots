{
  "name": "@j3-bots/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "bin": {
    "j3-bots": "./dist/bin.mjs"
  },
  "type": "module",
  "exports": {
    "./transition": {
      "types": "./src/transition/index.ts",
      "import": "./src/transition/index.ts"
    },
    "./network": {
      "types": "./src/system/Network.ts",
      "import": "./src/system/Network.ts"
    },
    "./home-entries": {
      "types": "./src/home/entries.ts",
      "import": "./src/home/entries.ts"
    },
    "./transfer-report": {
      "types": "./src/transfer/report.ts",
      "import": "./src/transfer/report.ts"
    },
    "./free-space": {
      "types": "./src/system/freeSpace.ts",
      "import": "./src/system/freeSpace.ts"
    },
    "./windows-acl": {
      "types": "./src/home/windowsAcl.ts",
      "import": "./src/home/windowsAcl.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "start": "node src/bin.ts serve",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir src",
    "every-surface:host": "node every-surface/host.ts",
    "scripted": "vp test run --config ../../vite.config.ts --dir scripted",
    "smoke:release": "vp test run --config ../../vite.config.ts --dir smoke",
    "smoke:windows": "vp test run --config ../../vite.config.ts smoke/windows.test.ts",
    "upgrade-check": "vp test run --config ../../vite.config.ts --dir upgrade-check"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@j3-bots/connectors": "workspace:*",
    "@j3-bots/contracts": "workspace:*",
    "@j3-bots/design-tokens": "workspace:*",
    "@j3-bots/engine-t3": "workspace:*",
    "@j3-bots/i18n": "workspace:*",
    "@j3-bots/processes": "workspace:*",
    "@j3-bots/prompts": "workspace:*",
    "@j3-bots/release": "workspace:*",
    "effect": "catalog:",
    "lean-qr": "2.7.4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "jsqr": "1.4.0",
    "vite-plus": "catalog:"
  }
}
