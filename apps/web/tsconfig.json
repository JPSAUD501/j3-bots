{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Severities deep-merge with tsconfig.effect.json. A browser client uses the
        // browser's clock and timers directly, as T3 Code's web client does.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalTimers": "off"
        }
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
