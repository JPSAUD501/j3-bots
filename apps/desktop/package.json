{
  "name": "@j3-bots/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "dev": "vp run --filter @j3-bots/web build && vp pack && node node_modules/electron/install.js && node scripts/launch.ts",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir src",
    "smoke": "vp run --filter @j3-bots/web build && vp pack && node node_modules/electron/install.js && vp test run --config ../../vite.config.ts --dir test"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@j3-bots/client-runtime": "workspace:*",
    "@j3-bots/contracts": "workspace:*",
    "@j3-bots/desktop-bridge": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@j3-bots/server": "workspace:*",
    "electron": "44.10.1",
    "playwright-core": "1.64.1",
    "vite-plus": "catalog:"
  }
}
